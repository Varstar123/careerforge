# ============================================================
# CareerForge AI — Environment Variables
# Copy this file to `.env.local` and fill in the values.
# ============================================================

# --- Database (PostgreSQL) ---
# Local:   postgresql://postgres:postgres@localhost:5432/careerforge
# Hosted:  Neon / Supabase / Railway connection string
# Runtime connection. On serverless hosts (Vercel) use the Supabase
# transaction pooler: ...pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/careerforge?schema=public"
# Direct connection, used only by Prisma migrations (port 5432).
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/careerforge?schema=public"

# --- Clerk Authentication (https://dashboard.clerk.com) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="your-clerk-publishable-key"
CLERK_SECRET_KEY="your-clerk-secret-key"
# Webhook signing secret for syncing users into the DB (Clerk → /api/webhooks/clerk)
CLERK_WEBHOOK_SIGNING_SECRET="your-clerk-webhook-signing-secret"

# Clerk redirect URLs (defaults work for local dev)
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/dashboard"
# Optional: bypass Clerk only for `next dev` local testing.
# LOCAL_AUTH_BYPASS="true"

# --- AI provider (any OpenAI-compatible API) ---
# Groq (create a key at https://console.groq.com).
GROQ_API_KEY="your-groq-api-key"
# Optional OpenAI alternative (API usage is billed separately).
# OPENAI_API_KEY="your-openai-api-key"
# Optional model overrides. Groq defaults to qwen/qwen3.8-27b.
# Check Groq's pricing and current free-plan limits before enabling usage:
# https://console.groq.com/docs/models
# LLM_FAST_MODEL="qwen/qwen3.8-27b"
# LLM_SMART_MODEL="qwen/qwen3.8-27b"

# --- Job Finder ---
# Job Finder uses public Greenhouse boards; no job API credentials required.
# Protects the daily /api/cron/refresh-jobs endpoint. Generate: openssl rand -hex 24
CRON_SECRET="generate-a-random-secret"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
