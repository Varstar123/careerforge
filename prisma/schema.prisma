// CareerForge AI — Prisma schema
// Postgres datasource. Run `npx prisma migrate dev` after setting DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Runtime uses the pooled connection (DATABASE_URL); migrations use the
  // direct connection (DIRECT_URL). On Vercel, DATABASE_URL must be the
  // Supabase transaction pooler (port 6543, ?pgbouncer=true).
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum InterviewFocus {
  TECHNICAL
  BEHAVIORAL
  HR
  MIXED
}

enum InterviewStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
}

enum QuestionType {
  TECHNICAL
  BEHAVIORAL
  HR
  SYSTEM_DESIGN
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum EmploymentType {
  FULLTIME
  PARTTIME
  INTERNSHIP
  CONTRACT
  FREELANCE
  OTHER
}

enum WorkMode {
  REMOTE
  HYBRID
  ONSITE
  UNKNOWN
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  firstName String?
  lastName  String?
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resumes       Resume[]
  interviews    Interview[]
  jobMatches    JobMatch[]
  jobPreference JobPreference?
}

model Resume {
  id        String   @id @default(cuid())
  userId    String
  fileName  String
  fileType  String
  rawText   String   @db.Text
  // Structured extraction { skills, education, experience, projects, summary, seniority }
  parsed    Json?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  interviews Interview[]

  @@index([userId])
}

model Interview {
  id           String          @id @default(cuid())
  userId       String
  resumeId     String?
  title        String
  targetRole   String
  seniority    String          @default("Entry")
  focus        InterviewFocus  @default(MIXED)
  status       InterviewStatus @default(DRAFT)
  overallScore Int? // 0-100, set when completed
  summary      String?         @db.Text
  createdAt    DateTime        @default(now())
  completedAt  DateTime?

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume    Resume?    @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  questions Question[]

  @@index([userId])
  @@index([status])
}

model Question {
  id          String       @id @default(cuid())
  interviewId String
  order       Int
  type        QuestionType
  category    String // e.g. "React", "Data Structures", "Leadership"
  text        String       @db.Text
  difficulty  Difficulty   @default(MEDIUM)
  rationale   String?      @db.Text // why this question was asked (from resume)

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  answer    Answer?

  @@index([interviewId])
}

model Answer {
  id         String   @id @default(cuid())
  questionId String   @unique
  text       String   @db.Text
  createdAt  DateTime @default(now())

  question   Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  evaluation Evaluation?
}

model Evaluation {
  id           String   @id @default(cuid())
  answerId     String   @unique
  score        Int // 0-100 overall for this answer
  correctness  Int // 0-100
  communication Int // 0-100
  depth        Int // 0-100
  strengths    Json // string[]
  improvements Json // string[]
  feedback     String   @db.Text
  modelAnswer  String?  @db.Text
  createdAt    DateTime @default(now())

  answer Answer @relation(fields: [answerId], references: [id], onDelete: Cascade)
}

// ── Job & Internship Finder ──────────────────────────────────────────────

// Cached job listing (deduped by external id), tagged with the query that
// surfaced it. Shared across all users to conserve the JSearch free quota.
model JobListing {
  id             String         @id @default(cuid())
  source         String         @default("jsearch")
  externalId     String         @unique
  title          String
  company        String
  location       String?
  workMode       WorkMode       @default(UNKNOWN)
  employmentType EmploymentType @default(OTHER)
  description    String         @db.Text
  skills         Json // string[]
  qualifications Json // string[]
  postedAt       DateTime?
  deadline       DateTime?
  applyUrl       String         @db.Text
  queryKey       String // normalized query that surfaced this listing
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  matches JobMatch[]

  @@index([queryKey])
}

// Per-query freshness tracker for the 24h cache TTL.
model JobQuery {
  id            String   @id @default(cuid())
  queryKey      String   @unique
  role          String
  location      String?
  curated       Boolean  @default(false) // refreshed by the daily cron
  lastFetchedAt DateTime @default(now())
  resultCount   Int      @default(0)
}

// Per-user ranking of a listing against their resume (stores score + reason).
model JobMatch {
  id         String   @id @default(cuid())
  userId     String
  jobId      String
  matchScore Int // 0-100
  reason     String   @db.Text // "why this matches you"
  createdAt  DateTime @default(now())

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  JobListing @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId])
}

// Per-user filters / preferences for the finder.
model JobPreference {
  id              String   @id @default(cuid())
  userId          String   @unique
  roles           Json // string[]
  locations       Json // string[]
  remoteOnly      Boolean  @default(false)
  jobTypes        Json // EmploymentType[]
  experienceLevel String   @default("entry") // entry | student | any
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
